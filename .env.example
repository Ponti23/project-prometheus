# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=your-nebius-token-factory-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm the exact id with: python scripts/verify_nebius.py
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: live search of the trusted source sites (data/sources.json) via Tavily
# TAVILY_API_KEY=tvly-your-key-here

# Optional
# PROMETHEUS_DB=var/prometheus.db
# PROMETHEUS_DAILY_TURNS_PER_HOUSEHOLD=80
# PROMETHEUS_DAILY_TURNS_GLOBAL=2000
# PROMETHEUS_MAX_TOOL_ROUNDS=6
